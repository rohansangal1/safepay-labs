{
  "name": "payment-integration-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-aware assurance measurement for payment integrations (PIAS)",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/*",
    "lab"
  ],
  "scripts": {
    "test": "node --test \"packages/**/*.test.ts\" \"lab/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "assess": "node lab/subjects/reference/assess.ts",
    "evidence": "node lab/subjects/reference/assess.ts --evidence",
    "harm": "node lab/subjects/reference/harm.ts",
    "build:site": "node scripts/build-site.ts",
    "library:update": "node scripts/update-library.ts",
    "library:abstracts": "node scripts/update-library.ts --backfill-only",
    "site": "npm run build:site && uv run python -m portal.dev",
    "researcher": "uv run --env-file .env.local python -m portal.cli",
    "test:portal": "uv run ruff check portal api && uv run pytest -q",
    "checkout": "node lab/subjects/reference/server.ts",
    "checkout:event": "node lab/subjects/reference/send-event.ts",
    "check:generated": "npm run assess && npm run harm && npm run build:site && git diff --exit-code -- data/runs data/harm site/score.js site/data"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "typescript": "7.0.2"
  }
}
